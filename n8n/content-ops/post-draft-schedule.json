      "parameters": {
        "jsCode": "const msg = $json.message || {};\nconst text = msg.text || msg.caption || '';\n\n// Regex extractor: captures everything after a tag until it hits the next tag (or end of message)\nconst extract = (tag) => {\n  const regex = new RegExp(`${tag}:\\\\s*([\\\\s\\\\S]*?)(?=\\\\s+(?:p|t|n|c):|$)`, 'i');\n  const match = text.match(regex);\n  return match ? match[1].trim() : '';\n};\n\n// Extract fields regardless of line breaks or spaces\nconst rawPlatform = extract('p').toLowerCase();\nconst tone = extract('t');\nconst notes = extract('n');\nlet rawContent = extract('c');\n\n// Fallback: If you don't use the c: tag at all, treat the whole block as raw content\nif (!rawContent && !text.match(/(?:p|t|n|c):/i)) {\n  rawContent = text.trim();\n}\n\n// Expanded Abbreviation & Capitalization Mapping\nconst platformMap = {\n  'x': 'x',\n  'twitter': 'x',\n  'twit': 'x',\n  'tw': 'x',\n  \n  'pinterest': 'pinterest',\n  'pin': 'pinterest',\n  \n  'linkedin': 'LinkedIn',\n  'link': 'LinkedIn',\n  'lkdin': 'LinkedIn',\n  'in': 'LinkedIn',\n  \n  'substack': 'substack',\n  'sub': 'substack'\n};\n\n// Map the abbreviation to the exact Airtable spelling, or fallback to whatever you typed\nconst platform = platformMap[rawPlatform] || rawPlatform;\n\n// Handle image extraction logic\nconst photos = Array.isArray(msg.photo) ? msg.photo : [];\nconst largest = photos.length ? photos[photos.length - 1] : null;\n\nreturn [{ json: {\n  platform,\n  tone,\n  notes,\n  raw_content: rawContent,\n  has_photo: !!largest && platform === 'pinterest', // Maps any 'pin' input to 'pinterest' first, then checks\n  photo_file_id: largest ? largest.file_id : '',\n  chat_id: msg.chat ? msg.chat.id : null,\n} }];"
      },
