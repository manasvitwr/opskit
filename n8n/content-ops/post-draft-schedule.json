        "jsCode": "const text = ($json.message && ($json.message.text || $json.message.caption)) || '';\nconst raw = text.replace('/posted', '').trim().toLowerCase();\nconst map = { x: 'X', pinterest: 'Pinterest', substack: 'Substack' };\nconst platform = map[raw] || (raw ? raw.charAt(0).toUpperCase() + raw.slice(1) : '');\nreturn [{ json: { platform, chat_id: $json.message && $json.message.chat ? $json.message.chat.id : null } }];"
      },
