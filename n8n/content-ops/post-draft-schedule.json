      "parameters": {
        "jsCode": "const src = $('Parse Draft').item.json;\n\nconst out =\n  $json.text ??\n  $json.output ??\n  $json.response ??\n  $json.message?.content ??\n  '';\n\nconst polished = typeof out === 'string'\n  ? out.trim()\n  : String(out || '').trim();\n\nreturn [{\n  json: {\n    platform: src.platform,\n    raw_input: src.raw_content,\n    polished_text: polished,\n    theme_concept: src.tone || '',\n    notes: src.notes || '',\n    has_photo: src.has_photo,\n    photo_file_id: src.photo_file_id,\n    chat_id: src.chat_id,\n  }\n}];"
      },
